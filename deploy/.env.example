# Set these in the Windows runtime account / service environment, not browser code.
TRADEDEN_DOMAIN=tradeden.example.com
TRADEDEN_USERNAME=owner
# Generate interactively with caddy hash-password; never commit passwords or hashes.
TRADEDEN_PASSWORD_HASH=
TRADEDEN_WEB_ROOT=C:/TRADEden/app/dist
TRADING_HUB_DATA_DIR=C:/TRADEden/data
TRADING_HUB_CORS_ORIGINS=https://tradeden.example.com
# Verify against your actual broker before setting this.
TRADING_HUB_MT5_SOURCE_TIMEZONE=
TRADING_HUB_REPORTING_TIMEZONE=Africa/Nairobi
