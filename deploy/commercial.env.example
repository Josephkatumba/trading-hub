# TEMPLATE ONLY. Load server values from protected service environment, never commit secrets.
TRADING_HUB_AUTH_MODE=oidc
TRADING_HUB_PUBLIC_ORIGIN=https://your-domain.example
TRADING_HUB_OIDC_ISSUER=https://your-tenant.auth0.com/
TRADING_HUB_OIDC_CLIENT_ID=replace-me
TRADING_HUB_OIDC_CLIENT_SECRET=replace-me
TRADING_HUB_SESSION_SECRET=replace-with-at-least-32-random-characters
TRADING_HUB_DATABASE_URL=postgresql+psycopg://user:password@localhost/tradeden
TRADING_HUB_MIN_NET_RR=1.5
# Additional round-trip commission/slippage in each instrument's PRICE units; spread is automatic.
TRADING_HUB_ROUND_TRIP_COST_PRICE=0
TRADING_HUB_COSTS_BY_SYMBOL={}
# Set verified broker time basis; do not guess or use this example unchanged.
TRADING_HUB_MT5_SOURCE_TIMEZONE=replace-with-verified-broker-timezone
# Build-time frontend values (public, no secrets):
VITE_AUTH_REQUIRED=1
VITE_ENGINE_SAME_ORIGIN=1
VITE_BASE_PATH=/
