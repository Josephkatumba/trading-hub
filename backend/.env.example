# Optional macro/fundamentals provider
# Get this from Trading Economics. Never put broker passwords here.
TRADING_ECONOMICS_API_KEY=

# Reporting calendar used for daily setup performance
TRADING_HUB_REPORTING_TIMEZONE=Africa/Nairobi

# Future: keep execution credentials server-side only.

# Browser origins allowed to call the engine (comma-separated, explicit
# scheme://host[:port], no paths, "*" is rejected). Leave commented out to use
# the local dev defaults: http://localhost:5173, http://127.0.0.1:5173,
# http://localhost:4173, http://127.0.0.1:4173. Do not set it to an empty value.
# TRADING_HUB_CORS_ORIGINS=http://localhost:5173,https://<your-user>.github.io

# Broker/server clock of MT5 bar and tick times: "UTC", an IANA zone, or an IANA
# zone plus a fixed shift ("<zone>+HH:MM" = that zone's wall clock + HH:MM).
# Verified for IC Markets (ICMarketsSC-Demo) in Phase 8: America/New_York+07:00
# (UTC+3 in US summer time, UTC+2 in US winter time). Re-verify for any other
# broker/server before setting it; see backend/TIMESTAMP_AUDIT_REPORT.md.
# TRADING_HUB_MT5_SOURCE_TIMEZONE=America/New_York+07:00
